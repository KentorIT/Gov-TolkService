@model ConfirmMovedAccountModel
@{
    ViewData["Title"] = "Bekräfta flyttat konto";
}
<section aria-label="@ViewData["Title"]">
    <div class="row">
        <div class="col-sm-8 login-page page-shadow">
            <h1 class="padding-bottom-30px">@ViewData["Title"]</h1>
            Lägg till info om att användaren har flyttats, och att hen nu tillhör en annan organisation.
            <form method="post">
                <div class="row">
                    <div class="col-md-6">
                        <form-entry asp-for="NameFirst" />
                    </div>
                    <div class="col-md-6">
                        <form-entry asp-for="NameFamily" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <form-entry asp-for="PhoneWork" />
                    </div>
                    <div class="col-md-6">
                        <form-entry asp-for="PhoneCellphone" />
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-6">

                    </div>
                    <div class="col-md-6">
                        <button class="btn btn-success btn-large pull-right">Fortsätt</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-sm-4 welcome-info">
            @await Html.PartialAsync("_AppInfoSmall")
        </div>
    </div>
</section>
