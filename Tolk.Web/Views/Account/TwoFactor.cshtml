@model TwoFactorModel
@{
    ViewData["Title"] = "Ange valideringskod";
}
<section aria-label="@ViewData["Title"]">
    <div class="row">
        <div class="col-md-4 login-page page-shadow">
            <h1>@ViewData["Title"]</h1>
            <form method="post" class="do-not-check-dirty">
                <div class="row padding-bottom-30px">
                    <div class="col-xs-12">
                        @if (!string.IsNullOrEmpty(@Model.Message))
                        {
                            @await Html.PartialAsync("_InfoMessage", @Model.Message)
                        }
                        <input type="hidden" asp-for="ReturnUrl" />
                        <form-entry asp-for="Code" />
                    </div>
                </div>
                <div class="row padding-bottom-30px">
                    <div class="col-xs-12 text-align-center">
                        <button type="submit" class="btn btn-success btn-large">Registrera</button>
                    </div>
                </div>
                <div class="row padding-bottom-30px">
                    <div class="col-xs-12 text-align-center">
                        <a asp-action="GenerateNewValidationCode"asp-route-returnUrl="@Model.ReturnUrl" asp-controller="Account">Skicka ny kod</a>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-8 welcome-info">
            @await Html.PartialAsync("_AppInfo")
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
