@using Tolk.BusinessLogic
@using Tolk.BusinessLogic.Helpers
@using Tolk.BusinessLogic.Services
@using Tolk.Web.Helpers
@using Microsoft.Extensions.Options
@inject IOptions<TolkOptions> options
@inject Tolk.BusinessLogic.Services.ISwedishClock Clock
@{
    ViewData["Title"] = Constants.SystemName;
}
<div class="appInfo-header"><div class="appInfo-test">VÄLKOMMEN</div></div>
<div class="appInfo-subheader">@Constants.SystemName.ToUpper()</div>
<br />
<h2>Om tjänsten</h2>
<p>
    I @Constants.SystemName kan avropsberättigade myndigheter boka tolktjänster, och ramavtalsleverantörer (tolkförmedlingar) kan hantera bokningsförfrågningar.
</p>
<p>
    <a href="@options.Value.ExternalLinks.TermsOfUse" target="_blank">Användarvillkor</a>
</p>

<h2>Registrera användarkonto</h2>

@if (options.Value.EnableRegisterUser)
{
    <p>
        Du kan skapa ett eget användarkonto om din organisation har tillåtit egen registrering.
        Om du inte kan registrera ett konto själv behöver du kontakta din centrala administratör på din organisation. Om du inte vet vem det är, kan du kontakta <a href="mailto:@options.Value.Support.FirstLineEmail">@options.Value.Support.FirstLineEmail</a> för att få hjälp.
        Vid andra frågor är du också välkommen att kontakta <a href="mailto:@options.Value.Support.FirstLineEmail">@options.Value.Support.FirstLineEmail</a>
    </p>
}
else
{
    <p>
        Just nu är det inte möjligt att registrera sig själv i avropstjänsten. För mer information eller önskemål om att få ett konto kontakta <a href="mailto:@options.Value.Support.UserAccountEmail">@options.Value.Support.UserAccountEmail</a>
    </p>
}
<br />
<p>
    <small>
        &copy; 2018-@(((TimeTravelClock)Clock).SwedenNow.Year) - Kammarkollegiet
        (Version @GitHelper.Version)
    </small>
</p>

