@using Microsoft.Extensions.Options
@using Tolk.BusinessLogic.Helpers
@using Tolk.Web.Services
@inject SelectListService SelectListService
@inject IOptions<TolkOptions> options
@model RegisterViewModel
@{
    ViewData["Title"] = "Registrera användarkonto";
}
<div class="row">
    <div class="col-xs-12">
        <h1>@ViewData["Title"]</h1>
        <p>
            För att få tillgång till tjänsten, fyll i uppgifterna nedan. En aktiveringslänk kommer därefter skickas till den e-postadress du angett. <br /><br /><b>Observera: </b>Du kan endast skapa ett användarkonto om din organisation tillåtit att användare själva registrerar sina konton. Annars behöver du kontakta din centrala administratör på din organisation. Om du inte vet vem det är, kan du kontakta <a href="mailto:@options.Value.Support.FirstLineEmail">@options.Value.Support.FirstLineEmail</a> för att få hjälp.<br /><br />Ange alltid en personlig e-postadress när ni registrerar konto i tjänsten. Om ni vill kan ni sedan styra om er e-post till en funktionsbrevlåda via en särskild inställning.
        </p>
        <form method="post" asp-action="Register" asp-controller="Account" class="do-not-check-dirty">
            <div class="row padding-bottom-30px">
                <div class="col-xs-12">
                    <form-entry asp-for="Email" />
                    @if (Model != null && Model.DisplayRegisterInfoToCustomer)
                    {
                        <a title="Formulär för att registrera myndighet" target="_blank" href="@options.Value.ExternalLinks.RegisterCustomerInfo">Formulär för att registrera myndighet</a>
                        <br />
                        <br />
                    }
                    @if (Model != null && Model.ParentOrganisationId > 0)
                    {
                        <form-entry asp-for="OrganisationIdentifier" type="select" asp-items="SelectListService.SubOrganisations(Model.ParentOrganisationId)" class="allow-clear" />
                    }
                    <form-entry asp-for="FirstName" />
                    <form-entry asp-for="LastName" />
                </div>
            </div>
           
            <div class="row">
                <div class="col-xs-12 text-align-center">
                    <button type="submit" class="btn btn-success btn-large disable-on-click">Skicka</button>
                </div>
            </div>
        </form>
        <div class="row">
            <div class="col-xs-12 text-align-center">
                Har du redan ett konto?<br />
                Gå vidare till <a asp-action="Login">Logga in <span class="glyphicon glyphicon-triangle-right"></span></a>
            </div>
        </div>
    </div>
</div>
